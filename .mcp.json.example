{
  "mcpServers": {
    "moment-research": {
      "type": "http",
      "url": "https://scientificintelligence.org/api/mcp",
      "headers": {
        "Authorization": "Bearer ${MOMENT_API_KEY}"
      }
    },
    "moment-research-local": {
      "type": "stdio",
      "command": "node",
      "args": ["<KIT_PATH>/mcp-server/dist/index.js", "--api-url=http://localhost:3000"],
      "env": {
        "MOMENT_MCP_API_KEY": "${MOMENT_LOCAL_API_KEY}"
      }
    }
  }
}
